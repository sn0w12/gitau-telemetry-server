{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["package-lock.json", "dist"],
    "printWidth": 80,
    "trailingComma": "es5",
    "tabWidth": 4,
    "sortImports": true,
    "sortTailwindcss": {
        "stylesheet": "src/styles.css",
        "functions": ["cn", "cva"]
    },
    "sortPackageJson": true
}
