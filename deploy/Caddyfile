{
	servers {
		trusted_proxies static private_ranges
	}
	log {
		level ERROR
	}
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	handle /v1/batches {
		request_body {
			max_size 1MB
		}
		reverse_proxy server:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /healthz {
		reverse_proxy server:8080
	}

	handle /login {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	handle /assets/* {
		root * /srv/admin
		file_server
	}

	handle /favicon.svg {
		root * /srv/admin
		file_server
	}

	handle /logout {
		reverse_proxy server:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /auth/* {
		reverse_proxy server:8080
	}

	handle /v1/admin/* {
		reverse_proxy server:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		forward_auth server:8080 {
			uri /auth/verify
		}
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
